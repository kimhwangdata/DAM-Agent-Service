# days-in-a-minute agent — stage environment template.
# Copy to a stage file and fill in real values:
#   cp .env.example .env.test   # Windows dev machine (fake camera, mocked S3)
#   cp .env.example .env.dev    # bench Pi
#   cp .env.example .env.prod   # deployed Pi
# There is NO plain .env. Real stage files are gitignored — only this
# template is committed. NEVER put real secrets here.

# ── Identity ─────────────────────────────────────────────────────────────────
DEVICE_ID=dam-test              # required; stable per-device id (hostname conv.)
TIMEZONE=Asia/Seoul             # required; IANA tz — drives all local dates/times
# LOCATION_ID is OPTIONAL since phase 2: the agent-manager assigns locations
# (docs/design/02-agent-manager.md §6). Set it only for offline test stages.
LOCATION_ID=

# ── Upload (ADR-0003: NO AWS credentials on devices) ─────────────────────────
S3_BUCKET=knh-dam-store
S3_IMAGE_PREFIX=images/
# The agent uploads via presigned URLs from the upload-signer Lambda.
# DEVICE_TOKEN is an app token (revocable server-side, useless against AWS
# APIs) issued by scripts/aws/issue_device_token.py.
UPLOAD_SIGNER_URL=https://example12345.execute-api.ap-northeast-2.amazonaws.com
DEVICE_TOKEN=

# ── Capture (defaults shown; see docs/design/01-agent.md §7) ────────────────
VIDEO_MINUTES=1                 # minutes of video per 24 h → 48 s interval
CAPTURE_SIZE=1280,720           # W,H
QUEUE_MAX=64                    # in-memory upload queue bound
VIEWER_PORT=8080                # HTTP viewer/health port; 0 disables
# Night/long exposure ceiling in ms (0 = stock AE, ~66 ms max). Set on
# low-light sensors only (e.g. 5000 on the IMX462); keep well under the
# capture interval. Daytime exposure is unaffected — AE only goes long
# when the scene is dark.
MAX_EXPOSURE_MS=0
# Optional libcamera tuning file (empty = automatic). Set
# "imx219_noir.json" on filterless NoIR modules to fix pink whites.
TUNING_FILE=
# Manual night mode: below ~10 lux the agent disables AE and uses this
# exposure/gain (AE cannot exceed the tuning's ~66 ms shutter ceiling).
# 0 disables. Measured sweet spots: IMX462+F/0.95 -> 1000 ms gain 4;
# IMX477 -> 5000 ms gain 10. Keep exposure well under the 48 s interval.
NIGHT_EXPOSURE_MS=0
NIGHT_GAIN=8

# ── Thermal protection (docs/design/02-agent-manager.md §5.2) ────────────────
TEMP_WARN_C=75                  # health badge
TEMP_PAUSE_C=80                 # agent pauses capturing (stays online)
TEMP_RESUME_C=75                # auto-resume at or below this
TEMP_SHUTDOWN_C=85              # sustained (3 reads) → poweroff, IF enabled:
TEMP_SHUTDOWN_ENABLED=false     # keep false on remote/NAT devices!

# days-in-a-minute agent — stage environment template.
# Copy to a stage file and fill in real values:
#   cp .env.example .env.test   # Windows dev machine (fake camera, mocked S3)
#   cp .env.example .env.dev    # bench Pi
#   cp .env.example .env.prod   # deployed Pi
# There is NO plain .env. Real stage files are gitignored — only this
# template is committed. NEVER put real secrets here.

# ── Identity (required) ──────────────────────────────────────────────────────
LOCATION_ID=TEST                # S3 prefix + video naming identity (e.g. DIO21)
DEVICE_ID=dam-test              # stable per-device id (hostname convention)
TIMEZONE=Asia/Seoul             # IANA timezone — drives all local dates/times

# ── Upload (ADR-0003: NO AWS credentials on devices) ─────────────────────────
S3_BUCKET=knh-dam-store
S3_IMAGE_PREFIX=images/
# The agent uploads via presigned URLs from the upload-signer Lambda.
# DEVICE_TOKEN is an app token (revocable server-side, useless against AWS
# APIs) issued by scripts/aws/issue_device_token.py.
UPLOAD_SIGNER_URL=https://example-signer-url.lambda-url.ap-northeast-2.on.aws
DEVICE_TOKEN=

# ── Capture (defaults shown; see docs/design/01-agent.md §7) ────────────────
VIDEO_MINUTES=1                 # minutes of video per 24 h → 48 s interval
CAPTURE_SIZE=1280,720           # W,H
QUEUE_MAX=64                    # in-memory upload queue bound
VIEWER_PORT=8080                # HTTP viewer/health port; 0 disables
